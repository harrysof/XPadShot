<Window x:Class="XPadShot.Views.ShortcutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recording shortcut"
        Width="384" Height="358"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextPrimary}">

    <Grid Margin="18">
        <Border CornerRadius="10"
                Background="{StaticResource WindowFill}"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#05070B" BlurRadius="26" ShadowDepth="10" Opacity="0.6"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        CornerRadius="10,10,0,0"
                        Background="{StaticResource TitleFill}"
                        BorderBrush="#16000000"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Border CornerRadius="10,10,0,0" Height="19"
                                VerticalAlignment="Top"
                                Background="{StaticResource TitleGloss}"
                                IsHitTestVisible="False"/>
                        <DockPanel Margin="12,0,8,0" VerticalAlignment="Center" LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Style="{StaticResource CloseCaptionButton}" Click="Close_Click"
                                        ToolTip="Cancel">
                                    <Path Data="M0,0 L10,10 M10,0 L0,10"
                                          Stroke="#D9E6F4" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="TitleText"
                                       Text="Recording shortcut"
                                       Margin="2,0,0,0"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="16,14,16,16">
                    <TextBlock Text="Name" Style="{StaticResource SectionLabel}"/>
                    <TextBox x:Name="NameBox"
                             Style="{StaticResource GlassTextBox}"
                             Margin="0,6,0,0"/>

                    <TextBlock Text="Keys" Style="{StaticResource SectionLabel}" Margin="0,12,0,0"/>
                    <UniformGrid Columns="4" Margin="0,7,0,0">
                        <CheckBox x:Name="CtrlBox" Style="{StaticResource GlassCheckBox}" Content="Ctrl"
                                  Checked="Modifier_Changed" Unchecked="Modifier_Changed"/>
                        <CheckBox x:Name="AltBox" Style="{StaticResource GlassCheckBox}" Content="Alt"
                                  Checked="Modifier_Changed" Unchecked="Modifier_Changed"/>
                        <CheckBox x:Name="ShiftBox" Style="{StaticResource GlassCheckBox}" Content="Shift"
                                  Checked="Modifier_Changed" Unchecked="Modifier_Changed"/>
                        <CheckBox x:Name="WinBox" Style="{StaticResource GlassCheckBox}" Content="Win"
                                  Checked="Modifier_Changed" Unchecked="Modifier_Changed"/>
                    </UniformGrid>

                    <ComboBox x:Name="KeyBox"
                              Style="{StaticResource GlassCombo}"
                              Margin="0,8,0,0"
                              SelectedValuePath="VirtualKey"
                              SelectionChanged="KeyBox_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Border CornerRadius="7" Margin="0,10,0,0" Padding="11,8"
                            Background="#F2181F2B"
                            BorderBrush="{StaticResource ComboBorder}"
                            BorderThickness="1">
                        <TextBlock x:Name="PreviewText" FontSize="12"
                                   Text="Pick the key for this shortcut."/>
                    </Border>

                    <Grid Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GlassButton}"
                                    Content="Cancel"
                                    IsCancel="True"
                                    Margin="0,0,8,0"
                                    Click="Cancel_Click"/>
                            <Button x:Name="SaveButton"
                                    Style="{StaticResource GlassButton}"
                                    Content="Save"
                                    IsDefault="True"
                                    IsEnabled="False"
                                    Click="Save_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
