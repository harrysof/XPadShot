<Window x:Class="XPadShot.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XPadShot"
        Width="384" Height="196"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextPrimary}">

    <Grid Margin="18">
        <Border CornerRadius="10"
                Background="{StaticResource WindowFill}"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#05070B" BlurRadius="26" ShadowDepth="10" Opacity="0.6"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        CornerRadius="10,10,0,0"
                        Background="{StaticResource TitleFill}"
                        BorderBrush="#16000000"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Border CornerRadius="10,10,0,0" Height="19"
                                VerticalAlignment="Top"
                                Background="{StaticResource TitleGloss}"
                                IsHitTestVisible="False"/>
                        <DockPanel Margin="12,0,8,0" VerticalAlignment="Center" LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Style="{StaticResource CloseCaptionButton}" Click="Cancel_Click"
                                        ToolTip="Cancel">
                                    <Path Data="M0,0 L10,10 M10,0 L0,10"
                                          Stroke="#D9E6F4" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="TitleText"
                                       Text="Confirm"
                                       Margin="2,0,0,0"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="16,14,16,16">
                    <TextBlock x:Name="MessageText"
                               FontSize="12.5"
                               Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap"/>

                    <Grid Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GlassButton}"
                                    Content="Cancel"
                                    IsCancel="True"
                                    Margin="0,0,8,0"
                                    Click="Cancel_Click"/>
                            <Button x:Name="ConfirmButton"
                                    Style="{StaticResource GlassButton}"
                                    Content="Delete"
                                    IsDefault="True"
                                    Click="Confirm_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
