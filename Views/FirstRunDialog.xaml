<Window x:Class="XPadShot.Views.FirstRunDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to XPadShot"
        Width="400" Height="326"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextPrimary}">

    <Grid Margin="18">
        <Border CornerRadius="10"
                Background="{StaticResource WindowFill}"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#05070B" BlurRadius="26" ShadowDepth="10" Opacity="0.6"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        CornerRadius="10,10,0,0"
                        Background="{StaticResource TitleFill}"
                        BorderBrush="#16000000"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Border CornerRadius="10,10,0,0" Height="19"
                                VerticalAlignment="Top"
                                Background="{StaticResource TitleGloss}"
                                IsHitTestVisible="False"/>
                        <DockPanel Margin="12,0,8,0" VerticalAlignment="Center" LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Style="{StaticResource CloseCaptionButton}" Click="Close_Click"
                                        ToolTip="Skip with defaults">
                                    <Path Data="M0,0 L10,10 M10,0 L0,10"
                                          Stroke="#D9E6F4" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Welcome"
                                       Margin="2,0,0,0"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="16,14,16,16">
                    <TextBlock Text="Welcome to XPadShot"
                               FontSize="15"
                               FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Text="Pick the controller combo that saves a screenshot. You can rename profiles and change combos any time later."/>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="FirstCombo"
                                  Grid.Column="0"
                                  Style="{StaticResource GlassCombo}"
                                  ItemTemplate="{StaticResource ButtonOptionTemplate}"
                                  SelectedValuePath="Value"
                                  SelectionChanged="FirstCombo_SelectionChanged"/>

                        <TextBlock Grid.Column="1"
                                   Text="+"
                                   FontSize="15"
                                   Foreground="{StaticResource TextTertiary}"
                                   Margin="10,0"
                                   VerticalAlignment="Center"/>

                        <ComboBox x:Name="SecondCombo"
                                  Grid.Column="2"
                                  Style="{StaticResource GlassCombo}"
                                  ItemTemplate="{StaticResource ButtonOptionTemplate}"
                                  SelectedValuePath="Value"/>
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Button Style="{StaticResource GlassButton}"
                                Content="Start capturing"
                                HorizontalAlignment="Right"
                                Click="Start_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
