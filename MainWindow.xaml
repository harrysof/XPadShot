<Window x:Class="XPadShot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XPadShot"
        Icon="assets/Xpadshot.png"
        Width="430" Height="760"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextPrimary}">

    <Grid Margin="18">
        <Border CornerRadius="10"
                Background="{StaticResource WindowFill}"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#05070B" BlurRadius="26" ShadowDepth="10" Opacity="0.6"/>
            </Border.Effect>

            <Grid x:Name="ShellInner">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- whispered aurora, the 2007 nod (clipped to the shell in code) -->
                <Ellipse Width="360" Height="240"
                         HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-120,-90,0,0"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#1F59B6FF" Offset="0"/>
                            <GradientStop Color="#0059B6FF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- ============ Title bar ============ -->
                <Border Grid.Row="0"
                        CornerRadius="10,10,0,0"
                        Background="{StaticResource TitleFill}"
                        BorderBrush="#16000000"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Border CornerRadius="10,10,0,0" Height="19"
                                VerticalAlignment="Top"
                                Background="{StaticResource TitleGloss}"
                                IsHitTestVisible="False"/>
                        <DockPanel Margin="12,0,8,0" VerticalAlignment="Center" LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click"
                                        ToolTip="Minimize">
                                    <Path Data="M0,0 H11"
                                          Stroke="#D9E6F4" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Button>
                                <Button Style="{StaticResource CloseCaptionButton}" Click="Close_Click"
                                        ToolTip="Close to tray">
                                    <Path Data="M0,0 L10,10 M10,0 L0,10"
                                          Stroke="#D9E6F4" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Button>
                            </StackPanel>

                            <Image Source="assets/Xpadshot.png"
                                   Width="19" Height="19"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <TextBlock Text="XPadShot"
                                       Margin="9,0,0,0"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- ============ Master power / player panel ============ -->
                <Border Grid.Row="1"
                        BorderBrush="#33000000"
                        BorderThickness="0,0,0,1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#343E50" Offset="0"/>
                            <GradientStop Color="#1E2531" Offset="0.5"/>
                            <GradientStop Color="#141922" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.ColumnSpan="2"
                                Height="1"
                                VerticalAlignment="Top"
                                Background="#26FFFFFF"
                                IsHitTestVisible="False"/>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="POWER"
                                       FontSize="9.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextTertiary}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <ToggleButton x:Name="PowerSwitch"
                                          Style="{StaticResource PowerSwitch}"
                                          IsChecked="{Binding IsAppEnabled, Mode=TwoWay}"
                                          ToolTip="Pause or resume the screenshot and screen-recording combos. Controller tracking stays on."/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <StackPanel x:Name="PlayerPicker"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="PLAYER"
                                           FontSize="9.5"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextTertiary}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,9,0"/>
                                <ComboBox Width="112"
                                          Height="30"
                                          Style="{StaticResource GlassComboCompact}"
                                          ItemsSource="{Binding PlayerOptions}"
                                          ItemTemplate="{StaticResource ButtonOptionTemplate}"
                                          SelectedItem="{Binding SelectedPlayer, Mode=TwoWay}"
                                          ToolTip="Listen on this XInput position. Player N = XInput slot N."/>
                            </StackPanel>
                            <Grid Width="16" Height="16"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  ToolTip="Player LED: green 1, blue 2, yellow 3, purple 4. Controller tracking stays live when the power switch is off.">
                                <Ellipse Fill="#0A0D12"
                                         Stroke="#454F60"
                                         StrokeThickness="1"/>
                                <Ellipse Width="9" Height="9"
                                         Style="{StaticResource PlayerLed}"/>
                                <Ellipse Width="3" Height="2"
                                         Fill="#7AFFFFFF"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Top"
                                         Margin="5,3,0,0"
                                         IsHitTestVisible="False"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ Content ============ -->
                <Grid Grid.Row="2">
                    <StackPanel x:Name="ContentPanel" Margin="16,10,16,10">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Opacity" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAppEnabled}" Value="False">
                                        <Setter Property="Opacity" Value="0.42"/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                    <!-- Profiles -->
                    <ContentControl Style="{StaticResource GlassCard}" Padding="14,8" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Game profile" Style="{StaticResource SectionLabel}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <ComboBox Style="{StaticResource GlassComboCompact}"
                                              ItemsSource="{Binding Profiles}"
                                              ItemTemplate="{StaticResource ProfileTemplate}"
                                              SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"/>

                                    <TextBox x:Name="RenameBox"
                                             Style="{StaticResource GlassTextBox}"
                                             Padding="12,0"
                                             Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                             Text="{Binding RenameDraft, UpdateSourceTrigger=PropertyChanged}"
                                             KeyDown="RenameBox_KeyDown"
                                             LostFocus="RenameBox_LostFocus"/>
                                </Grid>

                                <Button Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource GlassIconButton}"
                                        Click="Rename_Click"
                                        ToolTip="Rename this profile">
                                    <Path Data="M2.5,11.5 L11,3 L13.5,5.5 L5,14 L2.5,14 Z"
                                          Stroke="#D9E6F4" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                          Fill="Transparent"/>
                                </Button>

                                <Button Grid.Column="2"
                                        Margin="6,0,0,0"
                                        Style="{StaticResource GlassIconButton}"
                                        Click="AddProfile_Click"
                                        ToolTip="New profile">
                                    <Path Data="M7,1 V13 M1,7 H13"
                                          Stroke="#D9E6F4" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Button>

                                <Button Grid.Column="3"
                                        Margin="6,0,0,0"
                                        Style="{StaticResource GlassIconButton}"
                                        Click="RemoveProfile_Click"
                                        IsEnabled="{Binding CanRemoveProfile}"
                                        ToolTip="Remove this profile">
                                    <Path Data="M2.5,4 H13.5 M5.5,4 V2.6 H10.5 V4 M4,4.4 L4.9,13.2 H11.1 L12,4.4"
                                          Stroke="#D9E6F4" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                          Fill="Transparent"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </ContentControl>

                    <!-- Combo picker -->
                    <ContentControl Style="{StaticResource GlassCard}" Padding="14,8" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Screenshot combo" Style="{StaticResource SectionLabel}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          Style="{StaticResource GlassComboCompact}"
                                          ItemsSource="{Binding FirstOptions}"
                                          ItemTemplate="{StaticResource ButtonOptionTemplate}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedProfile.First, Mode=TwoWay}"/>

                                <TextBlock Grid.Column="1"
                                           Text="+"
                                           FontSize="15"
                                           Foreground="{StaticResource TextTertiary}"
                                           Margin="10,0"
                                           VerticalAlignment="Center"/>

                                <ComboBox Grid.Column="2"
                                          Style="{StaticResource GlassComboCompact}"
                                          ItemsSource="{Binding SecondOptions}"
                                          ItemTemplate="{StaticResource ButtonOptionTemplate}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedProfile.Second, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>
                    </ContentControl>

                    <!-- Screen recording -->
                    <ContentControl Style="{StaticResource GlassCard}" Padding="14,8" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Screen recording" Style="{StaticResource SectionLabel}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          Style="{StaticResource GlassComboCompact}"
                                          ItemsSource="{Binding FirstOptions}"
                                          ItemTemplate="{StaticResource ButtonOptionTemplate}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedProfile.RecordFirst, Mode=TwoWay}"/>

                                <TextBlock Grid.Column="1"
                                           Text="+"
                                           FontSize="15"
                                           Foreground="{StaticResource TextTertiary}"
                                           Margin="10,0"
                                           VerticalAlignment="Center"/>

                                <ComboBox Grid.Column="2"
                                          Style="{StaticResource GlassComboCompact}"
                                          ItemsSource="{Binding RecordSecondOptions}"
                                          ItemTemplate="{StaticResource ButtonOptionTemplate}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedProfile.RecordSecond, Mode=TwoWay}"/>
                            </Grid>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          Style="{StaticResource GlassComboCompact}"
                                          ItemsSource="{Binding RecordShortcutOptions}"
                                          ItemTemplate="{StaticResource ShortcutOptionTemplate}"
                                          SelectedValuePath="Key"
                                          SelectedValue="{Binding SelectedProfile.RecordOptionKey, Mode=TwoWay}"
                                          ToolTip="The combo synthesizes this key combo - set the same hotkey in your recording tool."/>

                                <Button Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource GlassIconButton}"
                                        Click="AddShortcut_Click"
                                        ToolTip="New custom shortcut">
                                    <Path Data="M7,1 V13 M1,7 H13"
                                          Stroke="#D9E6F4" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Button>

                                <Button Grid.Column="2"
                                        Margin="6,0,0,0"
                                        Style="{StaticResource GlassIconButton}"
                                        Click="EditShortcut_Click"
                                        IsEnabled="{Binding CanEditShortcut}"
                                        ToolTip="Rename or change the keys of this shortcut">
                                    <Path Data="M2.5,11.5 L11,3 L13.5,5.5 L5,14 L2.5,14 Z"
                                          Stroke="#D9E6F4" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                          Fill="Transparent"/>
                                </Button>

                                <Button Grid.Column="3"
                                        Margin="6,0,0,0"
                                        Style="{StaticResource GlassIconButton}"
                                        Click="DeleteShortcut_Click"
                                        IsEnabled="{Binding CanEditShortcut}"
                                        ToolTip="Delete this shortcut">
                                    <Path Data="M2.5,4 H13.5 M5.5,4 V2.6 H10.5 V4 M4,4.4 L4.9,13.2 H11.1 L12,4.4"
                                          Stroke="#D9E6F4" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                          Fill="Transparent"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </ContentControl>

                    <!-- Hero: the shutter button -->
                    <ContentControl Style="{StaticResource GlassCard}" Padding="18,12,18,10" Margin="0,8,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <Grid Width="128" Height="128">
                                <Ellipse x:Name="LedGlow" Opacity="0">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#B8E2FF" Offset="0"/>
                                            <GradientStop Color="#59B6FF" Offset="0.45"/>
                                            <GradientStop Color="#2E8FE0" Offset="0.72"/>
                                            <GradientStop Color="#002E8FE0" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#59B6FF" BlurRadius="42" ShadowDepth="0" Opacity="0.9"/>
                                    </Ellipse.Effect>
                                </Ellipse>

                                <Image Source="assets/Button_Logo.png"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>

                                <Rectangle x:Name="LedFlash" Fill="#EAF6FF" Opacity="0">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="assets/Button_Logo.png" Stretch="Uniform"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Grid>

                            <TextBlock Text="{Binding StateWord}"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding StateDetail}"
                                       Style="{StaticResource HintText}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       MaxWidth="300"
                                       Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding SessionText}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextTertiary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,7,0,0"/>
                        </StackPanel>
                    </ContentControl>

                    <CheckBox Style="{StaticResource GlassCheckBox}"
                              Margin="4,10,0,0"
                              IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                              Content="Start with Windows (minimized to tray)"/>

                    <!-- Footer -->
                    <Grid Margin="4,9,4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Saves to Pictures\Screenshots"
                                       FontSize="11"
                                       Foreground="{StaticResource TextTertiary}"
                                       VerticalAlignment="Center"
                                       ToolTip="{Binding FolderPath}"/>
                            <Button Style="{StaticResource GlassIconButton}"
                                    Width="26" Height="21"
                                    Margin="7,0,0,0"
                                    Click="OpenFolder_Click"
                                    ToolTip="Open screenshots folder">
                                <Path Data="M1.5,3.5 H6 L8,5.5 H14.5 V12.5 H1.5 Z"
                                      Stroke="#9FB6CE" StrokeThickness="1.3"
                                      StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                      Fill="Transparent"/>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="v1.9"
                                   FontSize="11"
                                   Foreground="{StaticResource TextTertiary}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    </StackPanel>

                    <Border Background="#4410151D" IsHitTestVisible="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAppEnabled}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
